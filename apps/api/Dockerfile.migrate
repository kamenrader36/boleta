# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine3.23@sha256:23f198931d4bd83b4f5a613bd75656257ae8bf832dcbc2db80e1050b5219ca2a AS build

WORKDIR /src

COPY tools/goose/go.mod tools/goose/go.sum ./

ARG TARGETOS TARGETARCH

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download \
    && go mod verify \
    && CGO_ENABLED=0 \
       GOOS=$TARGETOS \
       GOARCH=$TARGETARCH \
       go build \
         -mod=readonly \
         -trimpath \
         -ldflags="-s -w" \
         -tags="no_clickhouse no_libsql no_mssql no_mysql no_sqlite3 no_vertica no_ydb" \
         -o /out/goose \
         github.com/pressly/goose/v3/cmd/goose

FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63

RUN addgroup -g 65532 -S nonroot \
    && adduser -u 65532 -S nonroot -G nonroot

WORKDIR /app

COPY --from=build --chown=root:root --chmod=0555 /out/goose /usr/local/bin/goose
COPY --chown=root:root apps/api/db/migrations /app/db/migrations

RUN find /app/db/migrations -type d -exec chmod 0555 {} \; \
    && find /app/db/migrations -type f -exec chmod 0444 {} \;

USER nonroot:nonroot

CMD ["sh", "-c", "exec goose -dir /app/db/migrations postgres \"$DATABASE_URL\" up"]